---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative canonical path, optional. */
  ogType?: string;
  /** Share image, root-relative (default: the site-wide card). */
  image?: string;
  /** Extra JSON-LD objects for this page (e.g. a BlogPosting). */
  jsonLd?: object[];
}

const { title, description, ogType = 'website', image = '/og.png', jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteName = "Link's Blog";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const imageUrl = new URL(image, Astro.site).href;

// The author is the same person as on liko.page; sharing the @id links the two sites.
const author = {
  '@type': 'Person',
  '@id': 'https://liko.page/#person',
  name: 'Link',
  alternateName: 'liko',
  url: 'https://liko.page/',
  sameAs: ['https://github.com/ralphbupt'],
};
const website = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  url: new URL('/', Astro.site).href,
  name: siteName,
  inLanguage: 'en',
  author: { '@id': author['@id'] },
};
const ld = { '@context': 'https://schema.org', '@graph': [website, author, ...jsonLd] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="author" content="Link" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />

    <link rel="icon" type="image/png" href="/images/favicon-32x32-next.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/images/favicon-16x16-next.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon-next.png" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Set theme before paint to avoid a flash of the wrong color scheme. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Analytics (GA4), property "Blog" -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B2EVXBY4Z5"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-B2EVXBY4Z5');
    </script>
  </head>
  <body>
    <Header />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
